{
  "name": "everroad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Everroad \u2014 an idle infinite driving game. Drive through a painted countryside forever.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "tsc --noEmit && vitest run && node scripts/build-models.mjs --check && vite build && node scripts/check-bundle-size.mjs",
    "format": "prettier --write",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\"",
    "size": "node scripts/check-bundle-size.mjs",
    "models": "node scripts/build-models.mjs",
    "models:check": "node scripts/build-models.mjs --check",
    "models:blender": "\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" --background --python tools/blender/build_models.py --",
    "models:smoke": "\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" --background --python tools/blender/smoke_test.py"
  },
  "dependencies": {
    "postprocessing": "^6.36.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "prettier": "^3.4.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
