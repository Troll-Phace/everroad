{
  "name": "everroad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Everroad — an idle infinite driving game. Drive through a painted countryside forever.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "tsc --noEmit && vitest run && vite build",
    "format": "prettier --write",
    "format:check": "prettier --check \"src/**/*.{ts,css}\""
  },
  "dependencies": {
    "postprocessing": "^6.36.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "prettier": "^3.4.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
